generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String
  name             String
  quotaBytes       Int           @default(1073741824)
  createdAt        DateTime      @default(now())
  folders          Folder[]
  files            File[]
  tags             Tag[]
  userShares       UserShare[]   @relation("SharedWith")
  fileVersions     FileVersion[]
  activitiesOwned  Activity[]    @relation("ActivityOwner")
  activitiesActed  Activity[]    @relation("ActivityActor")
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  parentId  String?
  parent    Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderToFolder")
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  files     File[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([parentId])
}

model File {
  id         String      @id @default(cuid())
  name       String
  path       String
  size       Int
  mimeType   String
  folderId   String?
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id])
  shares     Share[]
  userShares UserShare[]
  tags           Tag[]
  starred        Boolean       @default(false)
  currentVersion Int           @default(1)
  versions       FileVersion[]
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([ownerId])
  @@index([folderId])
}

model FileVersion {
  id            String   @id @default(cuid())
  fileId        String
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  path          String
  size          Int
  mimeType      String
  versionNumber Int
  createdAt     DateTime @default(now())
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([fileId])
}

model Activity {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation("ActivityOwner", fields: [ownerId], references: [id])
  actorId    String
  actor      User     @relation("ActivityActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetName String
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model Share {
  id         String    @id @default(cuid())
  token      String    @unique
  fileId     String
  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  password   String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([fileId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files     File[]
  createdAt DateTime @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
}

model UserShare {
  id             String   @id @default(cuid())
  fileId         String
  file           File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sharedWithId   String
  sharedWith     User     @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  role           String   @default("viewer")
  createdAt      DateTime @default(now())

  @@unique([fileId, sharedWithId])
  @@index([sharedWithId])
}
